# Copy to `.env` and set real values there only. This file must never contain production secrets.

PORT=8080
ENV=development

# MongoDB — local default; for Atlas put the full URI in `.env` only (user/password in `.env`).
MONGODB_URI=mongodb://localhost:27017/rloco
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER_HOST/?appName=YOUR_APP

# JWT (use a long random string in `.env` for real environments)
JWT_SECRET=change_me_in_dot_env
JWT_EXPIRY=24h

# Optional: restrict CORS in production (comma-separated origins)
# Example for https://rloko.com (see rloko/.do/app.yaml):
# CORS_ALLOWED_ORIGINS=https://rloko.com,https://www.rloko.com

# Global API rate limit (production only): max requests per client IP per minute.
# Default if unset: 500 (prod) / 1000 (dev). Raise if many users share one IP (e.g. office NAT).
# API_RATE_LIMIT_RPM=800

# Storage: local | s3 (MinIO, Cloudflare R2, or any S3-compatible)
STORAGE_TYPE=local
# For S3/R2, set all of the following in `.env` (not here):
# STORAGE_TYPE=s3
# STORAGE_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY=your_r2_access_key
# STORAGE_SECRET_KEY=your_r2_secret_key
# STORAGE_BUCKET=your-bucket-name
# STORAGE_PUBLIC_URL=https://pub-xxxx.r2.dev

# App URL for email links (verification, password reset)
APP_BASE_URL=http://localhost:5173
# Production: APP_BASE_URL=https://rloko.com

# Optional: admin email receives new-order alerts
# ADMIN_EMAIL=admin@yourdomain.com

# Email (SMTP) — set real credentials in `.env` for production
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your_sendgrid_api_key
# SMTP_FROM=noreply@yourdomain.com
# SMTP_FROM_NAME=R-Loko
# Optional aliases supported by backend config:
# SMTP_USERNAME / SMTP_PASS / SMTP_FROM_EMAIL

# Stripe — set in `.env` only (https://dashboard.stripe.com/apikeys)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Frontend: VITE_STRIPE_PUBLISHABLE_KEY in frontend/.env

# Browser Maps + Places key (HTTP referrer–restricted in GCP). Served to the SPA at GET /api/auth/client-config
# as google_maps_api_key so address autocomplete works without rebuilding the frontend (e.g. on a Droplet).
# Same key type as VITE_GOOGLE_MAPS_API_KEY; SPA uses build-time key if set, else this value from the API.
# GOOGLE_MAPS_BROWSER_KEY=
# (alias) GOOGLE_MAPS_API_KEY=

# Shippo (rates/labels)
# SHIPPO_API_KEY=shippo_test_...
# SHIPPO_FROM_NAME=Rloco Warehouse
# SHIPPO_FROM_EMAIL=shipping@example.com
# SHIPPO_FROM_PHONE=+1 555 123 4567
# SHIPPO_FROM_STREET1=123 Fashion Avenue
# SHIPPO_FROM_STREET2=
# SHIPPO_FROM_CITY=New York
# SHIPPO_FROM_STATE=NY
# SHIPPO_FROM_ZIP=10001
# SHIPPO_FROM_COUNTRY=US
# SHIPPO_PARCEL_LENGTH=10
# SHIPPO_PARCEL_WIDTH=8
# SHIPPO_PARCEL_HEIGHT=4
# SHIPPO_PARCEL_WEIGHT=0.5
# SHIPPO_DISTANCE_UNIT=in
# SHIPPO_MASS_UNIT=lb

# Twilio Verify — required at startup; replace with real values from Twilio Console in `.env` only.
TWILIO_ACCOUNT_SID=replace_with_real_account_sid_in_dot_env
TWILIO_AUTH_TOKEN=replace_with_real_auth_token_in_dot_env
TWILIO_VERIFY_SERVICE_SID=replace_with_real_verify_service_sid_in_dot_env
