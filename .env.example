# Copy to .env for local dev. For Railway: add these variables in Dashboard → Variables.
# Railway auto-detects variable names from this file – fill real values in the dashboard.

PORT=8080
ENV=development

# MongoDB (local: mongodb://localhost:27017/rloco | production: mongodb+srv://...)
MONGODB_URI=mongodb://localhost:27017/rloco

# JWT (use a strong random secret in production)
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=24h

# CORS: comma-separated origins (e.g. https://yourfrontend.vercel.app)
# CORS_ALLOWED_ORIGINS=

# Storage: local | s3 (MinIO, R2, or S3-compatible)
STORAGE_TYPE=local
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=rloco-uploads
# STORAGE_PUBLIC_URL=  # For S3/R2 public URLs

# App URL for email links (verification, password reset)
APP_BASE_URL=http://localhost:5173

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Google OAuth (https://console.cloud.google.com → Credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Shippo (rates/labels) – https://goshippo.com
SHIPPO_API_KEY=shippo_test_...
SHIPPO_FROM_NAME=Rloco Warehouse
SHIPPO_FROM_EMAIL=support@rloco.com
SHIPPO_FROM_PHONE=+1 (555) 123-4567
SHIPPO_FROM_STREET1=123 Fashion Avenue
SHIPPO_FROM_CITY=New York
SHIPPO_FROM_STATE=NY
SHIPPO_FROM_ZIP=10001
SHIPPO_FROM_COUNTRY=US
SHIPPO_PARCEL_LENGTH=10
SHIPPO_PARCEL_WIDTH=8
SHIPPO_PARCEL_HEIGHT=4
SHIPPO_PARCEL_WEIGHT=0.5
SHIPPO_DISTANCE_UNIT=in
SHIPPO_MASS_UNIT=lb

# Optional: admin email for order alerts
# ADMIN_EMAIL=admin@yourdomain.com

# Optional: SMTP for production email
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your_sendgrid_api_key
# SMTP_FROM=noreply@yourdomain.com
# SMTP_FROM_NAME=R-Loko
