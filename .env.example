# Copy to .env and adjust for local dev
PORT=8080
ENV=development

# MongoDB (local: default below; Docker: use mongodb://admin:password@localhost:28017/rloco?authSource=admin)
MONGODB_URI=mongodb+srv://adminrloko_db_user:I9G1r0yaJ5PU3AR5@rloko-cluster.e36vvie.mongodb.net/?appName=rloko-cluster

# JWT (use a strong secret in production)
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=24h

# Optional: restrict CORS in production (comma-separated origins)
# CORS_ALLOWED_ORIGINS=https://yourfrontend.com

# Storage: local | s3 (MinIO, Cloudflare R2, or any S3-compatible)
# Local (default):
STORAGE_TYPE=s3
STORAGE_ENDPOINT=https://2f0d50297104bc7470c342f1afb85e9a.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=51ed55b916199d51b3e183591743561c
STORAGE_SECRET_KEY=45f4618ce1202ba1730fc5d074b8a60f137f1916cb0834e312266409f68038ec
STORAGE_BUCKET=rloco-uploads
STORAGE_PUBLIC_URL=https://pub-2f0d50297104bc7470c342f1afb85e9a.r2.dev

# R2/S3 (Option A cloud): set STORAGE_TYPE=s3, use R2 endpoint and API token
# STORAGE_TYPE=s3
# STORAGE_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY=your_r2_access_key
# STORAGE_SECRET_KEY=your_r2_secret_key
# STORAGE_BUCKET=rloco-uploads
# STORAGE_PUBLIC_URL=https://pub-xxxx.r2.dev

# App URL for email links (verification, password reset)
APP_BASE_URL=https://yourdomain.com

# Optional: admin email receives new-order alerts
# ADMIN_EMAIL=admin@yourdomain.com

# Email (SMTP) – required for production notifications; leave empty to skip sending (logs only)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your_sendgrid_api_key
# SMTP_FROM=noreply@yourdomain.com
# SMTP_FROM_NAME=R-Loko

# Stripe (get keys from https://dashboard.stripe.com/apikeys; webhook from Developers → Webhooks)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Frontend: set VITE_STRIPE_PUBLISHABLE_KEY=pk_test_... for card payments via Stripe Elements
# PAYPAL_CLIENT_ID= PAYPAL_SECRET= PAYPAL_MODE=sandbox

# Shippo (rates/labels). Shippo shipment quoting needs both an origin and destination address.
# SHIPPO_API_KEY=shippo_test_...
# SHIPPO_FROM_NAME=Rloco Warehouse
# SHIPPO_FROM_EMAIL=shipping@rloco.com
# SHIPPO_FROM_PHONE=+1 555 123 4567
# SHIPPO_FROM_STREET1=123 Fashion Avenue
# SHIPPO_FROM_STREET2=
# SHIPPO_FROM_CITY=New York
# SHIPPO_FROM_STATE=NY
# SHIPPO_FROM_ZIP=10001
# SHIPPO_FROM_COUNTRY=US
# SHIPPO_PARCEL_LENGTH=10
# SHIPPO_PARCEL_WIDTH=8
# SHIPPO_PARCEL_HEIGHT=4
# SHIPPO_PARCEL_WEIGHT=0.5
# SHIPPO_DISTANCE_UNIT=in
# SHIPPO_MASS_UNIT=lb
