meta {
  name: Update review
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/products/{{productId}}/reviews/{{reviewId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {"title":"Updated title","comment":"Still happy after a month.","images":[]}
}
