meta {
  name: Create review
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/products/{{productId}}/reviews
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {"rating":5,"title":"Love it","comment":"Great quality and fit.","images":[],"verified":true}
}
