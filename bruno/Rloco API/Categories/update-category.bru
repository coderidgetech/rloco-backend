meta {
  name: Update category
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/categories/{{categoryId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {"name":"Dresses","slug":"dresses","gender":"women","subcategories":["Mini","Midi"],"image":"https://example.com/cat.jpg","order":1}
}
