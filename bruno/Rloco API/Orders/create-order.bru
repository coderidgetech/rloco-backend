meta {
  name: Create order
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/orders
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {"items":[{"product_id":"{{productId}}","product_name":"Dress","image":"","price":99.99,"size":"M","quantity":1,"is_gift":false}],"shipping_info":{"first_name":"Jane","last_name":"Doe","email":"jane@example.com","phone":"+15551234567","address":"123 Fashion Ave","city":"New York","state":"NY","zip_code":"10001","country":"US"},"payment_info":{},"payment_method":"stripe","gift_packing_charge":0}
}
