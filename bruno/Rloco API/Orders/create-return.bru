meta {
  name: Create return
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/orders/{{orderId}}/return
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {"items":[{"order_item_id":"{{orderItemId}}","product_id":"{{productId}}","product_name":"Dress","size":"M","quantity":1,"price":99.99}],"reason":"defective","description":"Optional longer description"}
}
