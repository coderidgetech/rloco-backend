meta {
  name: Update tax rate
  type: http
  seq: 42
}

put {
  url: {{baseUrl}}/api/admin/tax/rates/{{taxRateId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {"country":"US","state":"CA","rate":8.25,"tax_type":"sales_tax","is_active":true}
}
